# Homebase Kinnect — required environment variables
#
# Copy this file to `.env.local` and fill in real values, and set the same
# keys in the Vercel project (Settings → Environment Variables).
# NEVER commit `.env.local` — it holds the service-account private key.

# --- Private family access ---
# A strong shared phrase (12+ characters) used by the wall display and family browsers.
HOMEBASE_ACCESS_PASSPHRASE=
# A separate random value of at least 32 characters used to sign remembered-device cookies.
HOMEBASE_SESSION_SECRET=
# Optional: remembered-device lifetime in days (defaults to 90, maximum 365).
HOMEBASE_SESSION_DAYS=90

# --- Google service account (shared read access to the Sheet / Calendar / Drive folder) ---
GOOGLE_CLIENT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
# Paste the full key as one line with literal \n escapes, wrapped in quotes:
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# --- Data sources ---
# Google Sheet holding the meal plan + grocery data
GOOGLE_SPREADSHEET_ID=
# Optional legacy alias still recognized by the meal-swap action.
GOOGLE_SHEETS_SPREADSHEET_ID=
# Google Calendar read for the day's schedule
GOOGLE_CALENDAR_ID=
# Google Drive folder holding the rotating family "Memories" photos
GOOGLE_DRIVE_FOLDER_ID=

# --- Automated school-email imports ---
# Used only on the server to extract teacher emails and homework images/PDFs.
ANTHROPIC_API_KEY=
SCHOOL_IMPORT_MODEL=claude-sonnet-5
# Shared bearer secret used by the private Gmail importer endpoint.
SCHOOL_IMPORT_SECRET=

# --- Analytics ---
# Shared secret for the nightly meal-history close-out cron. Generate any random
# string; Vercel sends it as `Authorization: Bearer <value>` on scheduled runs.
CRON_SECRET=

# --- Weekly meal-insights email ---
# Protects the read-only report endpoint called by the family's Apps Script.
MEAL_REPORT_SECRET=
